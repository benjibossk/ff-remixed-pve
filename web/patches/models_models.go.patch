+// ServerEvent = journal admin unifie. Une ligne par evenement notable du serveur :
+// connexion, deconnexion, chat, action admin... Les kills restent dans damage_events
+// (format historique, deja exploite par la carte) ; la page /journal fusionne les deux.
+//
+// Alimente par le plugin Fleet (POST /api/v1/events/log). Volontairement generique :
+// un `Type` + un `Details` libre, pour ajouter un type d'evenement sans migration.
+//
+// Credit : le decoupage des evenements (CONNECT/DISCONNECT, plateforme du joueur) est
+// repris de "ReforgerJS Support" (685448E58B08F021), avec l'accord de son auteur. Notre
+// implementation est autonome : elle ne lit pas ses fichiers, Fleet emet directement.
+type ServerEvent struct {
+	ID             uint      `gorm:"primaryKey"`
+	ServerID       uuid.UUID `gorm:"type:varchar(36);index:idx_srv_evt_time"`
+	EventTimestamp time.Time `gorm:"index:idx_srv_evt_time"`
+
+	// CONNECT | DISCONNECT | CHAT | ADMIN | GAME
+	Type string `gorm:"size:32;index"`
+
+	PlayerUID  string `gorm:"size:255;index"`
+	PlayerName string `gorm:"size:100"`
+	// platform-windows / platform-xbl / platform-psn -> permet de voir d'ou vient un joueur.
+	Platform string `gorm:"size:32;index"`
+	Faction  string `gorm:"size:50"`
+
+	// Contenu libre selon le type : message de chat, cause de kick, cible d'une action...
+	Message string `gorm:"type:text"`
+	Details string `gorm:"type:text"`
+}
+
+func (ServerEvent) TableName() string {
+	return "server_events"
+}
+
