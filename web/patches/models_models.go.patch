+// FFStateSample — historique ECHANTILLONNE de l'etat FF, pour suivre l'avancement
+// de la campagne (economie, territoire) dans le temps.
+//
+// POURQUOI : /ffstate n'etait garde qu'EN MEMOIRE (une map, un seul snapshot par
+// serveur, perdu au redemarrage). On voyait donc l'instant present, jamais une
+// evolution -- or "ou en est la campagne ?" est par nature une question de tendance :
+// les supplies qui montent, les usines qui basculent, le territoire qui change.
+//
+// Echantillonnage : un enregistrement par minute maximum (cf. ffstateSampleEvery).
+// Le jeu pousse toutes les ~5 s ; tout stocker ferait ~17k lignes/jour pour rien.
+// A 1/min on reste sous 1500 lignes/jour, largement suffisant pour une courbe.
+//
+// On ne stocke PAS le blob complet : uniquement des agregats numeriques. Le detail
+// reste dans le snapshot en memoire, qui lui n'a pas besoin d'historique.
+type FFStateSample struct {
+	ID         uint      `gorm:"primaryKey"`
+	ServerID   uuid.UUID `gorm:"type:varchar(36);index:idx_ffs_server_time"`
+	RecordedAt time.Time `gorm:"index:idx_ffs_server_time"`
+
+	// Territoire : nombre de POI par camp (villes, bases, usines, tours radio...).
+	PoisTotal  int
+	PoisPlayer int
+	PoisEnemy  int
+
+	// Detail par type, pour distinguer l'economique du militaire.
+	FactoriesPlayer int
+	FactoriesTotal  int
+	BasesPlayer     int
+	BasesTotal      int
+
+	// Economie : supplies cumules sur les sites tenus par le joueur, et capacite max.
+	// C'est la jauge d'avancement la plus parlante.
+	SuppliesPlayer int
+	SuppliesMax    int
+	FuelPlayer     int
+	FuelMax        int
+
+	// Debits MESURES par heure de jeu (FFRX_ProductionTracker cote jeu : stock lu
+	// avant/apres la production de FF, pas une formule rejouee). Le stock seul ne dit
+	// pas si la campagne progresse : deux serveurs a 3000 supplies n'ont pas le meme
+	// avenir selon qu'ils en produisent 40 ou 400 par heure.
+	ProdSupplies int
+	ProdFuel     int
+
+	// Meme mesure sur TOUTE la carte (sites tenus + ennemis). Une usine ennemie
+	// produit elle aussi : sans cette serie on ne voit que ce qu'on possede, jamais
+	// ce qui reste a prendre. C'est la difference entre les deux qui dit ou en est
+	// la campagne.
+	SuppliesAll    int
+	SuppliesMaxAll int
+	ProdSuppliesAll int
+	FuelAll        int
+	FuelMaxAll     int
+	ProdFuelAll    int
+
+	// Stations-service tenues / totales (les usines ont deja Factories*).
+	FuelStationsPlayer int
+	FuelStationsTotal  int
+
+	// Pression ennemie : effectifs de garnison adverses cumules.
+	EnemyManpower int
+
+	PlayersOnline int
+
+	// Agregats deja calcules par le JEU (bloc "summary" du payload). On les reprend
+	// tels quels plutot que de les recalculer : c'est la meme mesure que celle
+	// affichee en jeu, donc pas de divergence possible entre le site et le serveur.
+	// CampaignPct est la jauge d'avancement la plus directe.
+	CampaignPct float64
+	PlayerPct   float64
+	EnemyPct    float64
+}
+
+func (FFStateSample) TableName() string {
+	return "ffstate_samples"
+}
