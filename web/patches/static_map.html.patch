+      const fresh = Array.isArray(a) && a.some(p => (now - (p.eventTimestamp||0)) < 20);
+      if(fresh) setStat('active','En ligne'); else setStat('wait','En attente');
+    }catch(e){ setStat('', 'Hors ligne'); }
+  }
+  checkFlux(); setInterval(checkFlux, 3000);
+
