+// GetServerCurrentMapHandler (public) : carte actuelle du serveur, lue frais en base (no-store).
+// Sert au frontend pour basculer automatiquement quand le jeu change de terrain.
+func GetServerCurrentMapHandler(c *gin.Context) {
+	serverID, err := uuid.Parse(c.Param("id"))
+	if err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid server ID"})
+		return
+	}
+	var server models.Server
+	if err := database.DB.Preload("MapConfig").First(&server, "id = ?", serverID).Error; err != nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "server not found"})
+		return
+	}
+	server.MapConfig.TilesURL = rewriteTilesURL(server.MapConfig.TilesURL)
+	c.Header("Cache-Control", "no-store")
+	c.JSON(http.StatusOK, server.MapConfig)
+}
