+// playerStatInput = derniers grade/xp/faction reçus pour un joueur sur ce tick.
+type playerStatInput struct {
+	rank       int
+	xp         int
+	factionKey string
+	inVehicle  bool
+	posX       float64
+	posZ       float64
+}
+
+// updatePlayerStats met à jour la fiche cumulée par joueur/serveur : dernier grade/xp/faction,
+// premier/dernier vu, et TEMPS DE JEU cumulé (on n'ajoute le delta que si < 60 s -> évite de
+// compter les périodes hors ligne). Async (goroutine) après la sauvegarde des positions.
+func updatePlayerStats(serverID uuid.UUID, updates map[string]playerStatInput) {
+	if len(updates) == 0 {
+		return
+	}
+	const maxGapSeconds = 60.0
+	now := time.Now().UTC()
+
+	for guid, u := range updates {
+		var stat models.PlayerStat
+		err := database.DB.Where("server_id = ? AND player_guid = ?", serverID, guid).First(&stat).Error
+		if err != nil {
+			// Nouvelle fiche.
+			newStat := models.PlayerStat{
+				ServerID: serverID, PlayerGUID: guid,
+				LastRank: u.rank, LastXP: u.xp, FactionKey: u.factionKey,
+				FirstSeen: now, LastSeen: now, PlaytimeSeconds: 0,
+				LastPosX: u.posX, LastPosZ: u.posZ,
+			}
+			if err := database.DB.Create(&newStat).Error; err != nil {
+				log.Printf("ERROR (PlayerStats): create %s: %v", guid, err)
+			}
+			continue
+		}
+		gap := now.Sub(stat.LastSeen).Seconds()
+		if gap > 0 && gap < maxGapSeconds {
+			stat.PlaytimeSeconds += int64(gap)
+			if u.inVehicle {
+				stat.DriveSeconds += int64(gap)
+			} else {
+				stat.WalkSeconds += int64(gap)
+			}
+			// Distance : delta depuis la dernière position, capé pour ignorer respawn/téléport.
+			if (u.posX != 0 || u.posZ != 0) && (stat.LastPosX != 0 || stat.LastPosZ != 0) {
+				step := math.Hypot(u.posX-stat.LastPosX, u.posZ-stat.LastPosZ)
+				if step > 0 && step < 2000 {
+					stat.DistanceMeters += step
+				}
+			}
+		}
+		if u.posX != 0 || u.posZ != 0 {
+			stat.LastPosX = u.posX
+			stat.LastPosZ = u.posZ
+		}
+		stat.LastRank = u.rank
+		stat.LastXP = u.xp
+		if u.factionKey != "" {
+			stat.FactionKey = u.factionKey
+		}
+		stat.LastSeen = now
+		if err := database.DB.Save(&stat).Error; err != nil {
+			log.Printf("ERROR (PlayerStats): save %s: %v", guid, err)
+		}
+	}
+}
