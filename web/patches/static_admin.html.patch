+        // ===== Effectifs & Grades (setrank via file d'ordres web -> jeu) =====
+        const fltRgbSolid = (v) => { v = Number(v) || 0; if (v < 0) v = v >>> 0; const r = (v >>> 16) & 255, g = (v >>> 8) & 255, b = v & 255; return `rgb(${r},${g},${b})`; };
+        const fltEsc = (s) => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
+
+        let rosterState = { serverId: null, rows: [], catalog: {}, squadByGuid: new Map(), sortKey: 'playtime', onlineOnly: false };
+
+        const fmtPlaytime = (sec) => {
+            sec = Number(sec) || 0;
+            const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60);
+            if (h > 0) return `${h}h ${String(m).padStart(2, '0')}m`;
+            if (m > 0) return `${m}m`;
+            return `${Math.floor(sec)}s`;
+        };
+
+        async function fetchRoster(serverId) {
+            if (!serverId) return;
+            const body = document.getElementById('roster-table-body');
+            const status = document.getElementById('roster-status');
+            status.textContent = 'Chargement...';
+            body.innerHTML = '<tr><td colspan="5" class="text-center"><div class="spinner-border spinner-border-sm"></div></td></tr>';
+            try {
+                // roster = TOUS les joueurs déjà connectés (fiche PlayerStat) ; catalogue grades ; escouades (live).
+                const [roster, ranksCatalog] = await Promise.all([
+                    fetchData(`servers/${serverId}/roster`),
+                    fetchData(`public/ranks/${serverId}`).catch(() => ({}))
+                ]);
+                renderRankCatalog(ranksCatalog || {});
+                let squads = [];
+                try { squads = await fetchData(`public/squads/${serverId}`); } catch (_) {}
+                const squadByGuid = new Map();
+                (squads || []).forEach(sq => (sq.members || []).forEach(u => squadByGuid.set(u, sq)));
+
+                rosterState = {
+                    serverId, rows: roster || [], catalog: ranksCatalog || {}, squadByGuid,
+                    sortKey: rosterState.sortKey, onlineOnly: rosterState.onlineOnly
+                };
+
+                if (!rosterState.rows.length) {
+                    body.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Aucun joueur enregistré sur ce serveur pour le moment.</td></tr>';
+                    status.textContent = '';
+                    return;
+                }
+                renderRoster();
+                const online = rosterState.rows.filter(r => r.online).length;
+                status.textContent = `${rosterState.rows.length} joueur(s) · ${online} en ligne`;
+            } catch (e) {
+                body.innerHTML = `<tr><td colspan="5" class="text-danger text-center">Erreur : ${fltEsc(e.message)}</td></tr>`;
+                status.textContent = '';
+            }
+        }
+
+        function renderRoster() {
+            const body = document.getElementById('roster-table-body');
+            const { rows, catalog, squadByGuid, sortKey, onlineOnly } = rosterState;
+            body.innerHTML = '';
+            const nm = r => (r.name || r.playerGuid);
+
+            let list = rows.slice();
+            if (onlineOnly) list = list.filter(r => r.online);
+            list.sort((a, b) => {
+                if (sortKey === 'name') return nm(a).toUpperCase().localeCompare(nm(b).toUpperCase());
+                if (sortKey === 'rank') return (b.rank || 0) - (a.rank || 0) || nm(a).localeCompare(nm(b));
+                return (b.playtimeSeconds || 0) - (a.playtimeSeconds || 0); // temps de jeu décroissant
+            });
+
+            if (!list.length) {
+                body.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Aucun joueur (filtre « en ligne »).</td></tr>';
+                return;
+            }
+
+            list.forEach(r => {
+                const guid = r.playerGuid;
+                const facKey = r.factionKey || '';
+                const cat = catalog[facKey] || [];
+                const sq = squadByGuid.get(guid);
+
+                let rankControl;
+                if (cat.length) {
+                    rankControl = `<select class="form-select form-select-sm roster-rank" data-uid="${fltEsc(guid)}">` +
+                        cat.map(x => `<option value="${x.i}" ${x.i === r.rank ? 'selected' : ''}>${x.i} — ${fltEsc(x.name)}</option>`).join('') + `</select>`;
+                } else {
+                    const cur = (r.rank !== undefined && r.rank !== null) ? r.rank : '';
+                    rankControl = `<input type="number" min="0" value="${cur}" class="form-control form-control-sm roster-rank" data-uid="${fltEsc(guid)}" placeholder="n° grade" style="max-width:130px">`;
+                }
+
+                const found = cat.find(x => x.i === r.rank);
+                const detectedLabel = found
+                    ? `${fltEsc(found.name)} <small class="text-muted">(${r.rank})</small>`
+                    : `<span class="text-muted">n°</span> ${r.rank || 0}`;
+                const xp = (r.xp !== undefined && r.xp !== null) ? ` <small class="text-muted">· XP ${r.xp}</small>` : '';
+                const detectedCell = `<span class="badge text-bg-warning">${detectedLabel}</span>${xp}`;
+
+                const onlineDot = `<span class="d-inline-block rounded-circle me-2" style="width:9px;height:9px;background:${r.online ? '#46d17f' : '#43566a'}" title="${r.online ? 'En ligne' : 'Hors ligne'}"></span>`;
+                const squadDot = sq ? `<span class="d-inline-block rounded-circle ms-1" style="width:8px;height:8px;background:${fltRgbSolid(sq.color)}" title="${fltEsc(sq.name || '')}"></span>` : '';
+
+                const tr = document.createElement('tr');
+                tr.innerHTML = `<td>${onlineDot}<strong>${fltEsc(nm(r))}</strong>${squadDot}<br><small class="text-muted">${fltEsc(facKey)}</small></td>
+                    <td><i class="bi bi-clock-history me-1 text-muted"></i>${fmtPlaytime(r.playtimeSeconds)}</td>
+                    <td>${detectedCell}</td>
+                    <td>${rankControl}</td>
+                    <td class="text-end"><button class="btn btn-sm btn-success roster-apply" data-uid="${fltEsc(guid)}"><i class="bi bi-check-lg"></i> Appliquer</button><span class="roster-fb ms-2 small" data-uid="${fltEsc(guid)}"></span></td>`;
+                body.appendChild(tr);
+            });
+            body.querySelectorAll('.roster-apply').forEach(btn => {
+                btn.addEventListener('click', () => {
+                    const uid = btn.dataset.uid;
+                    const input = body.querySelector(`.roster-rank[data-uid="${CSS.escape(uid)}"]`);
+                    sendSetRank(rosterState.serverId, uid, input ? input.value : 0, body.querySelector(`.roster-fb[data-uid="${CSS.escape(uid)}"]`));
+                });
+            });
+        }
+
+        // Affiche le catalogue complet des grades détectés (poussé par Fleet), par faction.
+        function renderRankCatalog(ranksCatalog) {
+            const box = document.getElementById('roster-catalog');
+            const factions = Object.keys(ranksCatalog || {}).filter(k => (ranksCatalog[k] || []).length);
+            if (!factions.length) {
+                box.innerHTML = `<div class="alert alert-info mb-0 py-2 small"><i class="bi bi-info-circle me-1"></i>Aucun catalogue de grades détecté pour l'instant. Il arrive automatiquement dès que le mod Fleet tourne (envoi 1× au démarrage) — en attendant, le grade se saisit au numéro.</div>`;
+                return;
+            }
+            const total = factions.reduce((n, f) => n + ranksCatalog[f].length, 0);
+            let html = `<div class="card" style="background:rgba(6,11,16,.5)"><div class="card-body py-2">
+                <div class="d-flex align-items-center mb-2"><i class="bi bi-list-ol me-2"></i><strong>Grades détectés</strong>
+                <span class="badge text-bg-secondary ms-2">${total} au total</span></div>`;
+            factions.sort().forEach(f => {
+                const list = [...ranksCatalog[f]].sort((a, b) => a.i - b.i);
