+                    list.map(r => `<span class="badge text-bg-warning me-1 mb-1">${r.i} · ${fltEsc(r.name)}</span>`).join('') + `</div>`;
+            });
+            html += `</div></div>`;
+            box.innerHTML = html;
+        }
+
+        async function sendSetRank(serverId, uid, rank, fb) {
+            const r = parseInt(rank, 10);
