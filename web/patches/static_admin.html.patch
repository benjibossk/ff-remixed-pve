+                if (fb) { fb.textContent = '✓ ordre envoyé'; fb.className = 'roster-fb ms-2 small text-success'; }
+            } catch (e) {
+                if (fb) { fb.textContent = 'Erreur : ' + e.message; fb.className = 'roster-fb ms-2 small text-danger'; }
+            }
+        }
+
         initialize();
