# FF - REMIXED - PVE — what must NEVER reach the repository.
#
# Rule: we version TEMPLATES (*.example.*), never the real thing. A secret pushed
# once stays in git history even after you delete it — you then have to rewrite
# history AND rotate the secret. Far cheaper to never write it down.

# =======================================================================
#  SECRETS
# =======================================================================
# Dedicated server config: passwordAdmin, rcon.password.
config.json
install/server/config.json
# Website config: Discord client secret, session secret, AES key, DB password.
config.yaml
# Website API key used by the mod to push data to the live map.
GTG.json
**/Fleet/GTG.json
# Generic.
*.secret
*.secret.json
.env
.env.*
*.pem
*.key
!**/*.example.*

# =======================================================================
#  GAME AND SERVER DATA
# =======================================================================
# Saves and databases: server-specific, large, and full of Bohemia UIDs
# (personal data).
.save/
.db/
logs/
logs_*/
*.log
profile/profile/
install/server/profile/*.json
!install/server/profile/*.example.json
# Loadout snapshots: real player UIDs, and only meaningful on our own server.
backup/

# =======================================================================
#  BUILD ARTEFACTS
# =======================================================================
# Regenerated by the Workbench on every import; versioning them guarantees
# endless conflicts.
*.pak
*.rdb
resourceDatabase.rdb
*_manifest.json
ServerData.json
meta
thumbnail.png
preview*.jpg
# Website: the tree apply.sh assembles, and the compiled Go binary.
web/build/
gtg-livemap-server

# =======================================================================
#  WORKBENCH / EDITOR SCRATCH
# =======================================================================
*.ebackup
*.bak
*.bak_*
*.tmp
unnamed.ent
unnamed_Layers/
.idea/
.vscode/

# =======================================================================
#  DEAD WEIGHT
# =======================================================================
# Prefabs deliberately retired (see FFRX_SpecialistWeights.c): kept locally for
# reference, but shipping them would imply they are still wired in. They are not.
_REMOVED_*/
# Superseded working notes.
GAME_DESIGN_ARCHIVE.md
ETAT_SESSION_*.md
*.md.bak_*

# =======================================================================
#  MISC
# =======================================================================
Thumbs.db
desktop.ini
.DS_Store
scratchpad/

# Local credential scrub list for web/make-patches.sh. The left-hand side of each
# rule is a real secret, so this file must never be committed.
web/scrub.local
