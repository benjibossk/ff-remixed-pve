   Target_en_us "Good day. Do you have a moment?"\
   ""
   Target_fr_fr "Bonjour. Vous avez un instant ?"\
   ""
  }
  DefaultStringTableItem "{FF00000000030003}" {
   Id "MCD-Speech-Player-CivGreet03"
   Target_en_us "Hello. Don't be alarmed."\
   ""
   Target_fr_fr "Bonjour. N'ayez pas peur."\
   ""
  }
  DefaultStringTableItem "{FF00000000030004}" {
   Id "MCD-Speech-Player-CivAskPresence01"
   Target_en_us "Have you seen any soldiers around here?"\
   ""
   Target_fr_fr "Vous avez vu des soldats par ici ?"\
   ""
  }
  DefaultStringTableItem "{FF00000000030005}" {
   Id "MCD-Speech-Player-CivAskPresence02"
   Target_en_us "Are there any enemy patrols nearby?"\
   ""
   Target_fr_fr "Y a-t-il des patrouilles ennemies à proximité ?"\
   ""
  }
  DefaultStringTableItem "{FF00000000030006}" {
   Id "MCD-Speech-Player-CivAskPresence03"
   Target_en_us "Any military activity in the area?"\
   ""
   Target_fr_fr "De l'activité militaire dans le secteur ?"\
   ""
  }
  DefaultStringTableItem "{FF00000000020001}" {
   Id "MCD-Speech-GreetPos01"
   Target_en_us "Good to see you! Stay safe out there."\
   ""
   Target_fr_fr "Content de vous voir ! Faites attention à vous."\
   ""
  }
  DefaultStringTableItem "{FF00000000020002}" {
   Id "MCD-Speech-GreetPos02"
   Target_en_us "Thank god you're here. Keep fighting!"\
   ""
   Target_fr_fr "Dieu merci, vous êtes là. Continuez le combat !"\
   ""
  }
  DefaultStringTableItem "{FF00000000020003}" {
   Id "MCD-Speech-GreetPos03"
   Target_en_us "We're with you. Don't give up."\
   ""
   Target_fr_fr "On est avec vous. N'abandonnez pas."\
   ""
  }
  DefaultStringTableItem "{FF00000000020004}" {
   Id "MCD-Speech-GreetNeu01"
   Target_en_us "I don't want any trouble."\
   ""
   Target_fr_fr "Je ne veux pas d'ennuis."\
   ""
  }
  DefaultStringTableItem "{FF00000000020005}" {
   Id "MCD-Speech-GreetNeu02"
   Target_en_us "I'd rather not get involved... but go on."\
   ""
   Target_fr_fr "Je préfère ne pas m'en mêler... mais allez-y."\
   ""
  }
  DefaultStringTableItem "{FF00000000020006}" {
   Id "MCD-Speech-GreetNeu03"
   Target_en_us "What do you want? Make it quick."\
   ""
   Target_fr_fr "Qu'est-ce que vous voulez ? Faites vite."\
   ""
  }
  DefaultStringTableItem "{FF00000000020007}" {
   Id "MCD-Speech-GreetNeg01"
   Target_en_us "Get away from me! I'll report you!"\
   ""
   Target_fr_fr "Éloignez-vous ! Je vais vous dénoncer !"\
   ""
  }
  DefaultStringTableItem "{FF00000000020008}" {
   Id "MCD-Speech-GreetNeg02"
   Target_en_us "You terrorists are all the same. I'm calling the authorities!"\
   ""
   Target_fr_fr "Vous, les terroristes, êtes tous les mêmes. J'appelle les autorités !"\
   ""
  }
  DefaultStringTableItem "{FF00000000020009}" {
   Id "MCD-Speech-GreetNeg03"
   Target_en_us "Don't come near me! I know who you are!"\
   ""
   Target_fr_fr "N'approchez pas ! Je sais qui vous êtes !"\
   ""
  }
  DefaultStringTableItem "{FF00000000020013}" {
   Id "MCD-Speech-PresenceNear01"
   Target_en_us "Yes, there are soldiers not far from here. Be careful."\
   ""
   Target_fr_fr "Oui, il y a des soldats pas loin d'ici. Soyez prudent."\
   ""
  }
  DefaultStringTableItem "{FF00000000020014}" {
   Id "MCD-Speech-PresenceNear02"
   Target_en_us "I heard gunfire nearby. They must be close."\
   ""
   Target_fr_fr "J'ai entendu des tirs tout près. Ils ne doivent pas être loin."\
   ""
  }
  DefaultStringTableItem "{FF00000000020015}" {
   Id "MCD-Speech-PresenceNear03"
   Target_en_us "There's a patrol in the area. I saw them behind the church."\
   ""
   Target_fr_fr "Il y a une patrouille dans le secteur. Je les ai vus derrière l'église."\
   ""
  }
  DefaultStringTableItem "{FF00000000020016}" {
   Id "MCD-Speech-PresenceClear01"
   Target_en_us "I haven't seen anyone. Seems clear to me."\
   ""
   Target_fr_fr "Je n'ai vu personne. Ça me paraît tranquille."\
   ""
  }
  DefaultStringTableItem "{FF00000000020017}" {
   Id "MCD-Speech-PresenceClear02"
   Target_en_us "No soldiers around here right now."\
   ""
   Target_fr_fr "Aucun soldat dans le coin pour l'instant."\
   ""
  }
  DefaultStringTableItem "{FF00000000020018}" {
   Id "MCD-Speech-PresenceClear03"
   Target_en_us "It's quiet. I don't think they're here."\
   ""
   Target_fr_fr "C'est calme. Je ne crois pas qu'ils soient là."\
   ""
  }
  DefaultStringTableItem "{FF00000000020019}" {
   Id "MCD-Speech-PresenceRef01"
   Target_en_us "None of your business. Get lost."\
   ""
   Target_fr_fr "Ça ne vous regarde pas. Dégagez."\
   ""
  }
  DefaultStringTableItem "{FF0000000002001A}" {
   Id "MCD-Speech-PresenceRef02"
   Target_en_us "I don't talk to people like you."\
   ""
   Target_fr_fr "Je ne parle pas aux gens comme vous."\
   ""
  }
  DefaultStringTableItem "{FF0000000002001B}" {
   Id "MCD-Speech-PresenceRef03"
   Target_en_us "Ask someone else. I want nothing to do with this."\
   ""
   Target_fr_fr "Demandez à quelqu'un d'autre. Je ne veux rien avoir à faire avec ça."\
   ""
  }
  DefaultStringTableItem "{CD000000000C0030}" {
   Id "MCD-Speech-ConvertJackpot01"
   Target_en_us "Finally! I've been waiting for this. My friends and I are ready to join — all three of us!"\
   ""
   Target_fr_fr "Enfin ! J'attendais ça. Mes amis et moi sommes prêts à nous engager — tous les trois !"\
   ""
  }
  DefaultStringTableItem "{CD000000000C0031}" {
   Id "MCD-Speech-ConvertJackpot02"
   Target_en_us "You have no idea how long we've been hoping for this. Count me in — and two of my neighbors too."\
   ""
   Target_fr_fr "Vous n'imaginez pas depuis combien de temps on espère ça. Comptez sur moi — et sur deux de mes voisins aussi."\
   ""
  }
  DefaultStringTableItem "{CD000000000C0032}" {
   Id "MCD-Speech-ConvertJackpot03"
   Target_en_us "We've been talking about this for weeks. Me and two friends — we're with you. All of us."\
   ""
   Target_fr_fr "On en parle depuis des semaines. Moi et deux amis — on est avec vous. Tous."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB050}" {
   Id "MCD-ConvoAction-AskHelp"
   Target_en_us "Ask for help"\
   ""
   Target_fr_fr "Demander de l'aide"\
   ""
  }
  DefaultStringTableItem "{CD000000000AB051}" {
   Id "MCD-Speech-Player-CivAskHelp01"
   Target_en_us "Could you spare something to help the cause?"\
   ""
   Target_fr_fr "Vous auriez quelque chose pour aider la cause ?"\
   ""
  }
  DefaultStringTableItem "{CD000000000AB052}" {
   Id "MCD-Speech-Player-CivAskHelp02"
   Target_en_us "We could use a hand — anything you can give?"\
   ""
   Target_fr_fr "Un coup de main nous aiderait — vous avez quelque chose à donner ?"\
   ""
  }
  DefaultStringTableItem "{CD000000000AB053}" {
   Id "MCD-Speech-Player-CivAskHelp03"
   Target_en_us "Got anything that could help us out?"\
   ""
   Target_fr_fr "Vous avez quelque chose qui pourrait nous aider ?"\
   ""
  }
  DefaultStringTableItem "{CD000000000AB054}" {
   Id "MCD-Speech-HelpGift01"
   Target_en_us "Here, take this. Use it well."\
   ""
   Target_fr_fr "Tenez, prenez ça. Faites-en bon usage."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB055}" {
   Id "MCD-Speech-HelpGift02"
   Target_en_us "It's not much, but it's yours. Good luck."\
   ""
   Target_fr_fr "Ce n'est pas grand-chose, mais c'est à vous. Bonne chance."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB056}" {
   Id "MCD-Speech-HelpGift03"
   Target_en_us "Take it — I want to help however I can."\
   ""
   Target_fr_fr "Prenez-le — je veux aider comme je peux."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB057}" {
   Id "MCD-Speech-HelpNogift01"
   Target_en_us "I wish I had something to give right now."\
   ""
   Target_fr_fr "J'aimerais avoir quelque chose à donner là."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB058}" {
   Id "MCD-Speech-HelpNogift02"
   Target_en_us "Sorry, I've got nothing on me at the moment."\
   ""
   Target_fr_fr "Désolé, je n'ai rien sur moi pour le moment."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB059}" {
   Id "MCD-Speech-HelpNogift03"
   Target_en_us "I'd help if I could, but my hands are empty today."\
   ""
   Target_fr_fr "J'aiderais si je pouvais, mais je n'ai rien aujourd'hui."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB05A}" {
   Id "MCD-Speech-HelpAnnoyed01"
   Target_en_us "I've given you all I can. Please, leave me be now."\
   ""
   Target_fr_fr "Je vous ai donné tout ce que je pouvais. Laissez-moi tranquille maintenant."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB05B}" {
   Id "MCD-Speech-HelpAnnoyed02"
   Target_en_us "Enough — I can't keep helping you. Don't count on me anymore."\
   ""
   Target_fr_fr "Ça suffit — je ne peux pas continuer à vous aider. Ne comptez plus sur moi."\
   ""
  }
  DefaultStringTableItem "{CD000000000AB05C}" {
   Id "MCD-Speech-HelpAnnoyed03"
   Target_en_us "That's the last time. I've done my part, leave me alone."\
   ""
   Target_fr_fr "C'est la dernière fois. J'ai fait ma part, laissez-moi."\
   ""
  }
