     }
     VisibilityRange 10
     Duration 20
    }
   }
  }
 
 }
 {
  // Enfant declare ICI, et pas seulement herite du prefab de previsualisation.
  //
  // POURQUOI. EPF a bien sauvegarde la caisse (fichier BuildItems ... m_rPrefab
  // 9498ED9663810020) mais avec "m_aChildEntities": 0, alors que les depots
  // construits en ont 1 -- et eux revenaient apres un redemarrage. Seule
  // difference entre les deux prefabs : le Depot FR (depuis supprime) declarait son
  // enfant dans le prefab CONSTRUIT, la caisse se contentait de l'heriter du preview. Sans
  // enfant sauvegarde, la composition revient vide : la racine n'a pas de
  // geometrie, donc en jeu "la caisse a disparu".
  //
  // ⚠️ ON REUTILISE L'ID DE L'ENFANT HERITE (6FFEC0DEB111C114, cf.
  // FFRX_Preview_ArsenalBox). Un ID neuf n'ecraserait pas l'enfant du parent, il
  // en AJOUTERAIT un second -- deux caisses l'une dans l'autre.
  GenericEntity : "{B53B98CEA2D72735}Prefabs/Props/Military/Compositions/FIA/ArsenalBox_FIA.et" {
   ID "6FFEC0DEB111C114"
   coords 0 0 0
