  // CompositionBase (herite via FFRX_Preview_ArsenalBox) declare deja son propre
  // ActionsManagerComponent sous {5D66ED1096104FD8}. Avec un GUID different on n'en
  // SURCHARGE pas un, on en AJOUTE un second -- et le moteur refuse :
  //   ENTITY (E): component ActionsManagerComponent cannot be combined with ...
  // L'entite est alors construite de travers, SANS RplComponent, et FF n'arrive plus
  // a l'enregistrer :
  //   [JWK][BuildAreaControllerComponent] Cannot link build item, no Rpl
  // Consequence observee : la caisse construite n'etait JAMAIS persistee.
  // (Diagnostic etabli en comparant avec le Depot FR, qui reutilisait bien ce GUID et
  //  fonctionnait ; ce prefab a depuis ete supprime, la regle reste vraie.)
  ActionsManagerComponent "{5D66ED1096104FD8}" {
   ActionContexts {
    UserActionContext "{6FFEC0DEB111C127}" {
     "Display UI At Reference Point" 1
    }
   }
   additionalActions {
    JWK_DisassemblyConstructionAction "{6FFEC0DEB111C128}" {
     ParentContextList {
      "Disassembly"
     }
     UIInfo SCR_ActionUIInfo "{6FFEC0DEB111C129}" {
